# Copie este arquivo para `.env` (mesma pasta do docker-compose.yml) e ajuste os valores.
# `.env` nunca deve ser commitado.

DB_NAME=lashmanager
DB_USER=postgres
DB_PASS=postgres

# Obrigatório — gere uma string aleatória própria, não reaproveite a de dev.
# Ex: openssl rand -hex 32
JWT_SECRET=

CORS_ORIGINS=http://localhost:4200

# Opcional — só necessário se for testar o fluxo de ativação de conta por e-mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
