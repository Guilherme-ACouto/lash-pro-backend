<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lashmanager</groupId>
        <artifactId>lash-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>lash-app</artifactId>
    <name>lash-app</name>
    <description>Entry point — agrega todos os módulos e inicializa o Spring Boot</description>

    <dependencies>
        <!-- Módulos de negócio -->
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-clients</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-services</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-appointments</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-finance</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-stock</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-fichas</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lashmanager</groupId>
            <artifactId>lash-dashboard</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runtime -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Sobrescreve o skip=true do parent -->
                    <skip>false</skip>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
