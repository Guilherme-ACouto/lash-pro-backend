<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Parte do core que mora no schema de cada tenant (igual ao "changelog core" de tenant da
         Pontta, onde ficam cooperator/cooperator_role): colaboradores da assinatura e suas
         permissões finas por módulo/ação. -->

    <changeSet id="1" author="brava">
        <sqlFile path="db/changelog/core-tenant/create-collaborator-tables.sql"
                 relativeToChangelogFile="false"
                 splitStatements="true"
                 stripComments="true"/>
    </changeSet>

    <!-- Usuários que já existiam antes das permissões viram colaboradores da própria assinatura. -->
    <changeSet id="2" author="brava">
        <sql>
            INSERT INTO collaborator (user_id)
            SELECT id FROM public.users WHERE tenant_id = '${tenantId}'::uuid
            ON CONFLICT (user_id) DO NOTHING;
        </sql>
    </changeSet>
</databaseChangeLog>
